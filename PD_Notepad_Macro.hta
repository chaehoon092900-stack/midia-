<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>🎬 PD 생방송 연출 & 실제 메모장 매크로</title>
  <HTA:APPLICATION
    ID="PDNotepadApp"
    APPLICATIONNAME="PDNotepadMacro"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    ICON="notepad.exe"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
  />
  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      font-family: 'Malgun Gothic', sans-serif;
      margin: 0;
      padding: 20px;
      user-select: none;
    }
    .header {
      background: #2563eb;
      color: white;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
    }
    .title {
      font-size: 16px;
      font-weight: bold;
    }
    .subtitle {
      font-size: 12px;
      color: #dbeafe;
      margin-top: 4px;
    }
    .card {
      background: white;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 15px;
    }
    textarea {
      width: 100%;
      height: 80px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 10px;
      font-family: 'Malgun Gothic', sans-serif;
      font-size: 13px;
      box-sizing: border-box;
      resize: none;
    }
    .btn {
      width: 100%;
      background: #059669;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }
    .btn:hover {
      background: #047857;
    }
    .preset-btn {
      background: #e2e8f0;
      color: #334155;
      border: 1px solid #cbd5e1;
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 11px;
      cursor: pointer;
      margin-right: 4px;
      margin-top: 5px;
    }
    .status-box {
      padding: 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: bold;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      margin-bottom: 15px;
    }
    .btn-secondary {
      background: #4f46e5;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      width: 48%;
    }
    .btn-sheet {
      background: #059669;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      width: 48%;
      float: right;
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="title">🎬 PD 생방송 연출 & 실제 메모장 매크로</div>
    <div class="subtitle">시청자 글을 입력하면 오른쪽의 실제 윈도우 메모장에 즉시 직접 기입됩니다.</div>
  </div>

  <div class="card">
    <div style="font-size: 13px; font-weight: bold; margin-bottom: 8px;">💬 시청자 참여글 입력 (Enter 키 송출 지원)</div>
    <textarea id="inputText" placeholder="시청자가 작성한 글을 입력하고 [Enter] 키를 누르면 실제 메모장에 바로 적힙니다..." onkeydown="handleKeyDown()"></textarea>
    
    <div style="font-size: 11px; color: #64748b; margin-top: 8px;">⚡ 테스트용 샘플 프리셋:</div>
    <div>
      <button class="preset-btn" onclick="setPreset('오늘 라이브 방송 응원합니다 화이팅!')">✅ 정상 댓글</button>
      <button class="preset-btn" onclick="setPreset('와 오늘 무대 연출 진짜 미쳤다 ㅋㅋㅋ 대박!')">⚠️ 미쳤다 댓글</button>
      <button class="preset-btn" onclick="setPreset('진행자 진행 ㅈㄴ 못하네 ㅆㅂ 진짜 노답')">❌ 초성 욕설 차단</button>
      <button class="preset-btn" onclick="setPreset('제 전화번호 010-1234-5678 로 이벤트를 보내주세요!')">❌ 개인정보 차단</button>
    </div>

    <button class="btn" onclick="processInput()">📝 실제 윈도우 메모장에 직접 적기 (Enter)</button>
  </div>

  <div id="statusBox" class="status-box">
    💡 글을 입력하고 [엔터] 키를 누르면 실제 메모장(Notepad.exe)에 써집니다.
  </div>

  <div>
    <button class="btn-secondary" onclick="openNotepad()">📄 실제 메모장 창 열기</button>
    <button class="btn-sheet" onclick="copyAndOpenSheets()">📊 방송 종료: 구글 시트로 이동 및 붙여넣기</button>
  </div>

  <script language="VBScript">
    Dim fso, WshShell, logPath

    Sub window_onload()
      window.resizeTo 600, 680
      window.moveTo 100, 100

      Set fso = CreateObject("Scripting.FileSystemObject")
      Set WshShell = CreateObject("WScript.Shell")
      
      logPath = fso.GetAbsolutePathName("broadcast_log.txt")

      ' 매크로 프로그램 실행 시 메모장 초기화 및 현재 실행 시각 새로 기록
      If fso.FileExists(logPath) Then
        On Error Resume Next
        fso.DeleteFile(logPath)
      End If

      Dim stream
      Set stream = CreateObject("ADODB.Stream")
      stream.Type = 2
      stream.Charset = "utf-8"
      stream.Open
      stream.WriteText "=== [PD 생방송 연출 콘솔 - broadcast_log.txt] ===" & vbCrLf
      stream.WriteText "방송 시작 일시: " & Now & vbCrLf
      stream.WriteText "----------------------------------------------------------------------" & vbCrLf
      stream.WriteText "시각" & vbTab & "판정결과" & vbTab & "원문 텍스트" & vbTab & "최종 처리 텍스트" & vbTab & "차단/마스킹 사유" & vbCrLf
      stream.WriteText "----------------------------------------------------------------------" & vbCrLf
      stream.SaveToFile logPath, 2
      stream.Close

      openNotepad()
    End Sub

    Sub handleKeyDown()
      If window.event.keyCode = 13 Then
        window.event.returnValue = False
        processInput()
      End If
    End Sub

    Sub openNotepad()
      On Error Resume Next
      WshShell.Run "notepad.exe """ & logPath & """", 1, False
    End Sub

    Sub setPreset(textVal)
      document.getElementById("inputText").value = textVal
      processInput()
    End Sub

    Sub processInput()
      Dim rawText, isSafe, reason, filterText, nowTime, statusStr
      rawText = Trim(document.getElementById("inputText").value)

      If rawText = "" Then Exit Sub

      nowTime = Right("0" & Hour(Now), 2) & ":" & Right("0" & Minute(Now), 2) & ":" & Right("0" & Second(Now), 2)
      isSafe = True
      reason = "-"
      filterText = rawText

      ' 욕설 필터링
      If InStr(rawText, "시발") > 0 Or InStr(rawText, "씨발") > 0 Or InStr(rawText, "ㅅㅂ") > 0 Or InStr(rawText, "ㅆㅂ") > 0 Or InStr(rawText, "ㅂㅅ") > 0 Or InStr(rawText, "병신") > 0 Or InStr(rawText, "개새끼") > 0 Or InStr(rawText, "지랄") > 0 Or InStr(rawText, "꺼져") > 0 Or InStr(rawText, "노답") > 0 Or InStr(rawText, "ㅈㄴ") > 0 Or InStr(rawText, "존나") > 0 Then
        isSafe = False
        reason = "악성 욕설 및 초성 비속어(ㅆㅂ/ㅈㄴ) 포함"
        filterText = "-"
      ElseIf InStr(rawText, "010-") > 0 Or InStr(rawText, "011-") > 0 Or InStr(rawText, "010 ") > 0 Then
        isSafe = False
        reason = "개인정보(전화번호) 노출"
        filterText = "-"
      Else
        filterText = Replace(filterText, "미친", "***")
        filterText = Replace(filterText, "ㅁㅊ", "***")
      End If

      If isSafe Then
        statusStr = "승인 (Approve)"
        document.getElementById("statusBox").innerText = "🟢 [승인] 메모장에 직접 적히고 자막이 등록되었습니다! (" & filterText & ")"
        document.getElementById("statusBox").style.backgroundColor = "#d1fae5"
        document.getElementById("statusBox").style.color = "#065f46"
      Else
        statusStr = "차단 (Reject) "
        document.getElementById("statusBox").innerText = "🔴 [차단] 사유: " & reason & " (원문: " & rawText & ")"
        document.getElementById("statusBox").style.backgroundColor = "#fee2e2"
        document.getElementById("statusBox").style.color = "#991b1b"
      End If

      ' 실제 메모장 파일 쓰기
      Dim stream, existingContent
      Set stream = CreateObject("ADODB.Stream")
      stream.Type = 2
      stream.Charset = "utf-8"
      stream.Open

      If fso.FileExists(logPath) Then
        Dim readStream
        Set readStream = CreateObject("ADODB.Stream")
        readStream.Type = 2
        readStream.Charset = "utf-8"
        readStream.Open
        readStream.LoadFromFile logPath
        existingContent = readStream.ReadText(-1)
        readStream.Close
      Else
        existingContent = ""
      End If

      Dim newLine
      newLine = nowTime & vbTab & statusStr & vbTab & """" & rawText & """" & vbTab & """" & filterText & """" & vbTab & reason & vbCrLf

      stream.WriteText existingContent & newLine
      stream.SaveToFile logPath, 2
      stream.Close

      openNotepad()

      document.getElementById("inputText").value = ""
    End Sub

    ' ★ 메모장에 적힌 데이터 클립보드 자동 복사 후 구글 시트로 이동
    Sub copyAndOpenSheets()
      On Error Resume Next
      
      ' 메모장 내용 읽어오기
      Dim readStream, fileContent
      Set readStream = CreateObject("ADODB.Stream")
      readStream.Type = 2
      readStream.Charset = "utf-8"
      readStream.Open
      readStream.LoadFromFile logPath
      fileContent = readStream.ReadText(-1)
      readStream.Close

      ' 클립보드로 메모장 내용 복사
      window.clipboardData.setData "Text", fileContent

      MsgBox "🎉 [방송 종료 일괄 복사 완료]" & vbCrLf & vbCrLf & "메모장에 기록된 모든 데이터가 클립보드에 복사되었습니다!" & vbCrLf & "열리는 구글 시트의 A6 셀을 클릭하고 [Ctrl + V]를 누르면 일괄 붙여넣기됩니다.", 64, "구글 시트 연동"

      ' 구글 시트 이동
      WshShell.Run "cmd /c start https://docs.google.com/spreadsheets/d/12i5rUGrLTCYolnxHj04JYOrffCaiO5PR1hLX2gGZ-1g/edit", 0, False
    End Sub
  </script>
</body>
</html>
